#!/bin/bash

echo "[1/4] Fermo i container e pulisco i file..."
docker compose down

# Rimuovo il database
if [ -f "db.sqlite3" ]; then
    rm db.sqlite3
    echo "✔ Database db.sqlite3 rimosso."
fi

# Rimuovo le migrazioni (tranne __init__.py)
find catalogo/migrations/ -name "*.py" ! -name "__init__.py" -delete
echo "✔ Migrazioni in 'catalogo' rimosse."

echo "[2/4] Avvio i container..."
docker compose up -d

# Aspetto che il database sia pronto (per SQLite è immediato, ma diamo un secondo)
sleep 2

echo "[3/4] Genero nuove migrazioni..."
docker compose exec django-demo python manage.py makemigrations catalogo

echo "[4/4] Applico le migrazioni al database..."
docker compose exec django-demo python manage.py migrate

echo ""
echo "✨ Reset completato con successo! Il database è pulito e aggiornato."

./generate_admin