# Usa un'immagine Node.js ufficiale come base
FROM node:22-slim

# Imposta la directory di lavoro nel contenitore
WORKDIR /app

# Copia i file di configurazione delle dipendenze
COPY frontend/package*.json ./

# Installa le dipendenze
RUN npm install

# Copia il codice sorgente del frontend
COPY frontend/ ./

# Espone la porta su cui gira il server di sviluppo di Vite
EXPOSE 5173

# Avvia Vite abilitando l'host esterno (necessario per esporre la porta fuori dal container)
CMD ["npm", "run", "dev", "--", "--host"]
